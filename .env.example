# ============================================
# Tool Parking - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# ============================================

# ============================================
# Clerk Authentication
# ============================================
# Get these from: https://dashboard.clerk.com/
# Go to: API Keys section

# Required: Your Clerk publishable key (client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Your Clerk secret key (server-side only)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Clerk sign-in URL (defaults to /sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Optional: Clerk sign-up URL (defaults to /sign-up)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: URL to redirect to after sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/parking

# Optional: URL to redirect to after sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/parking

# ============================================
# MongoDB Database
# ============================================
# Get this from: https://cloud.mongodb.com/
# Or use a local MongoDB instance

# Required: MongoDB connection string
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tool-parking?retryWrites=true&w=majority

# Optional: MongoDB database name (defaults to 'tool-parking')
MONGODB_DB_NAME=tool-parking

# ============================================
# Application Configuration
# ============================================

# Optional: Application URL (for CORS and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Legacy Appwrite (No longer used, keep for reference)
# ============================================
# NEXT_PUBLIC_APPWRITE_ENDPOINT=
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=
# NEXT_PUBLIC_APPWRITE_TOOLS_COLLECTION_ID=
# NEXT_PUBLIC_APPWRITE_PROJECTS_COLLECTION_ID=
# NEXT_PUBLIC_APPWRITE_STACK_ITEMS_COLLECTION_ID=

# ============================================
# Instructions
# ============================================
#
# 1. CLERK SETUP:
#    a. Go to https://dashboard.clerk.com/
#    b. Create a new application
#    c. Go to "API Keys" section
#    d. Copy the "Publishable Key" to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#    e. Copy the "Secret Key" to CLERK_SECRET_KEY
#    f. Configure OAuth providers (GitHub, Google, etc.) in Clerk dashboard
#
# 2. MONGODB SETUP:
#    Option A - MongoDB Atlas (Cloud):
#    a. Go to https://cloud.mongodb.com/
#    b. Create a free cluster
#    c. Create a database user
#    d. Get your connection string
#    e. Replace username, password, and cluster in MONGODB_URI
#    
#    Option B - Local MongoDB:
#    a. Install MongoDB locally
#    b. Use: MONGODB_URI=mongodb://localhost:27017/tool-parking
#
# 3. SECURITY NOTES:
#    - NEVER commit .env.local to version control
#    - NEVER share your CLERK_SECRET_KEY or MONGODB_URI
#    - Use different keys for development and production
#    - Rotate keys regularly
#
# 4. PRODUCTION DEPLOYMENT:
#    - Set environment variables in your hosting platform
#    - Vercel: Project Settings → Environment Variables
#    - AWS: Secrets Manager or Parameter Store
#    - Docker: Use .env file or docker-compose environment section
#
# ============================================
